DATABASE_URL=postgresql://USER:PASSWORD@localhost:5435/DB_NAME
# Keep this modest on memory-constrained VPS hosts; raise it only after measuring.
DB_POOL_MAX=10
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3002
ALLOWED_ORIGINS=http://localhost:3002
# Keep 0 when clients connect directly; use 1 for one trusted reverse proxy.
TRUST_PROXY_HOPS=0

# ── Email (Gmail SMTP) ────────────────────────────────────────
# 2FA on → https://myaccount.google.com/apppasswords
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
FEEDBACK_RECIPIENT=tranphilong030201@gmail.com


# Google Gemini AI (required for Phase 2 AI features)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Abort stalled Gemini requests so background queues can recover.
GEMINI_REQUEST_TIMEOUT_MS=60000
KG_V2_ENABLED=false
